# OS / editor junk
.DS_Store
Thumbs.db
*.local

# Runtime logs (never commit)
*.log
server*.log
server*.err.log
nohup.out

# Python caches (rebuilt automatically)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python environment (rebuilt by bootstrap.ps1 -> pip install)
lib/venv/
lib/venv/**/*.pyc

# Local databases (recreated at startup by run.ps1)
*.db
*.db-journal
*.db-wal
*.db-shm
backend/data/*.db*
backend/*.db*
backend/tenants.db
backend/data/tenants.db

# Local deployment secrets (Docker compose)
.env
.env.local
